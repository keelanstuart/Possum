IDR_MAINFRAME MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New\tCtrl+N",                ID_NUCLEUS_FILE_NEW
        MENUITEM "&Open...\tCtrl+O",            ID_NUCLEUS_FILE_OPEN
        MENUITEM "&Close",                      ID_NUCLEUS_FILE_CLOSE
        MENUITEM "&Save\tCtrl+S",               ID_NUCLEUS_FILE_SAVE
        MENUITEM "Save &As...",                 ID_NUCLEUS_FILE_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "Recent File",                 ID_FILE_MRU_FILE1, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&View"
    BEGIN
        POPUP "&Toolbars and Docking Windows"
        BEGIN
            MENUITEM "<placeholder>",               ID_VIEW_TOOLBAR
        END
        MENUITEM "&Status Bar",                 ID_VIEW_STATUS_BAR
        MENUITEM "&Caption Bar",                ID_VIEW_CAPTION_BAR
        POPUP "&Application Look"
        BEGIN
            MENUITEM "&Blue Style",                 ID_VIEW_APPLOOK_OFF_2007_BLUE
            MENUITEM "B&lack Style",                ID_VIEW_APPLOOK_OFF_2007_BLACK
            MENUITEM "&Silver Style",               ID_VIEW_APPLOOK_OFF_2007_SILVER
            MENUITEM "&Aqua Style",                 ID_VIEW_APPLOOK_OFF_2007_AQUA
        END
        POPUP "Track Height"
        BEGIN
            MENUITEM "Tiny",                        ID_TRACKHEIGHT_TINY
            MENUITEM "Small",                       ID_TRACKHEIGHT_SMALL
            MENUITEM "Medium",                      ID_TRACKHEIGHT_MEDIUM
            MENUITEM "Large",                       ID_TRACKHEIGHT_LARGE
            MENUITEM "Huge",                        ID_TRACKHEIGHT_HUGE
        END
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About Possum...",            ID_APP_ABOUT
    END
END

IDR_PossumTYPE MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New\tCtrl+N",                ID_NUCLEUS_FILE_NEW
        MENUITEM "&Open...\tCtrl+O",            ID_NUCLEUS_FILE_OPEN
        MENUITEM "&Close",                      ID_NUCLEUS_FILE_CLOSE
        MENUITEM "&Save\tCtrl+S",               ID_NUCLEUS_FILE_SAVE
        MENUITEM "Save &As...",                 ID_NUCLEUS_FILE_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "Export...",                   ID_NUCLEUS_FILE_EXPORT
        MENUITEM SEPARATOR
        MENUITEM "Recent File",                 ID_FILE_MRU_FILE1, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Undo\tCtrl+Z",               ID_EDIT_UNDO
        MENUITEM SEPARATOR
        MENUITEM "Cu&t\tCtrl+X",                ID_EDIT_CUT
        MENUITEM "&Copy\tCtrl+C",               ID_EDIT_COPY
        MENUITEM "&Paste\tCtrl+V",              ID_EDIT_PASTE
    END
    POPUP "&View"
    BEGIN
        POPUP "&Toolbars and Docking Windows"
        BEGIN
            MENUITEM "<placeholder>",               ID_VIEW_TOOLBAR
        END
        MENUITEM "&Status Bar",                 ID_VIEW_STATUS_BAR
        MENUITEM "&Caption Bar",                ID_VIEW_CAPTION_BAR
        POPUP "&Application Look"
        BEGIN
            MENUITEM "&Blue Style",                 ID_VIEW_APPLOOK_OFF_2007_BLUE
            MENUITEM "B&lack Style",                ID_VIEW_APPLOOK_OFF_2007_BLACK
            MENUITEM "&Silver Style",               ID_VIEW_APPLOOK_OFF_2007_SILVER
            MENUITEM "&Aqua Style",                 ID_VIEW_APPLOOK_OFF_2007_AQUA
        END
        POPUP "Track Height"
        BEGIN
            MENUITEM "Tiny",                        ID_TRACKHEIGHT_TINY
            MENUITEM "Small",                       ID_TRACKHEIGHT_SMALL
            MENUITEM "Medium",                      ID_TRACKHEIGHT_MEDIUM
            MENUITEM "Large",                       ID_TRACKHEIGHT_LARGE
            MENUITEM "Huge",                        ID_TRACKHEIGHT_HUGE
        END
    END
    POPUP "&Window"
    BEGIN
        MENUITEM "&New Window",                 ID_WINDOW_NEW
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About Possum...",            ID_APP_ABOUT
    END
END

IDR_POPUP_EDIT MENU
BEGIN
    POPUP "Edit"
    BEGIN
        MENUITEM "Cu&t\tCtrl+X",                ID_EDIT_CUT
        MENUITEM "&Copy\tCtrl+C",               ID_EDIT_COPY
        MENUITEM "&Paste\tCtrl+V",              ID_EDIT_PASTE
