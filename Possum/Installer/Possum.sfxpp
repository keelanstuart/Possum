<scripts>

<script type="initialize">SetProperty(&quot;Create Desktop Shortcut&quot;, &quot;bool&quot;, &quot;yesno&quot;, 1);
</script>

<script type="preinstall">ShowLicenseAcceptanceDlg();</script>

<script type="postinstall">if (INSTALLOK == 1)
{
	CreateShortcut(&quot;%APPDATA%/Microsoft/Windows/Start Menu/Programs/Possum/Possum.lnk&quot;, BASEPATH + &quot;\\Possum64.exe&quot;, &quot;&quot;, BASEPATH, &quot;Possum&quot;, 1, BASEPATH + &quot;\\Possum64.exe&quot;, 0);

	Echo(&quot;Created Start Menu shortcuts.\n&quot;);

	if (GetProperty(&quot;Create Desktop Shortcut&quot;) == 1)
	{
		CreateShortcut(&quot;%HOMEPATH%/Desktop/Possum.lnk&quot;, BASEPATH + &quot;\\Possum.exe&quot;, &quot;&quot;, BASEPATH, &quot;Possum&quot;, 1, BASEPATH + &quot;\\Possum.exe&quot;, 0);

		Echo(&quot;Created Desktop shortcut.\n&quot;);
	}
}

</script>

</scripts>

